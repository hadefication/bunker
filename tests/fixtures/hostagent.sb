(version 1)
(allow default)
(deny network-outbound)
(allow network-outbound (remote unix-socket (subpath "/x/.lima/bunker-t")))
(deny mach-lookup (global-name "com.apple.dnssd.service"))
(allow network-outbound (remote ip "localhost:60100"))
(deny network-bind)
(allow network-bind (local tcp "localhost:60100"))
(allow network-bind (local unix-socket (subpath "/x/.lima/bunker-t")))
(deny file-write*)
(allow file-write* (subpath "/x/.lima/bunker-t") (subpath "/x/.lima/_config") (subpath "/var/folders/ab/T") (literal "/dev/null") (regex #"^/dev/tty") (literal "/dev/ptmx"))
(deny process-exec)
(allow process-exec (literal "/x/bin/limactl") (literal "/usr/bin/ssh") (literal "/usr/bin/sw_vers") (literal "/usr/sbin/system_profiler") (literal "/bin/sh") (literal "/bin/bash"))
